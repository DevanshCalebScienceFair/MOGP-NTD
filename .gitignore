__pycache__/
*.pyc
.pytest_cache/

# Docking artifacts: downloaded/derived by docking.py at runtime
1J3I.pdb
1J3I_clean.pdb
1J3I_clean.pdbqt
*.pdbqt
*.pdb

# TDC ChEMBL_V29 download cache (150 MB; regenerated by data.py via TDC MolGen,
# and far over GitHub's 100 MB limit — never commit it)
data/chembl_v29.csv

# Persistent docking cache (generated by docking.py; keyed SMILES+target)
data/docking_cache/

# Multi-seed benchmark output (generated by run_benchmark_seeds.py)
benchmark_seeds_results/

# Feature-matrix harness output (generated by run_matrix.py)
matrix_results/

# Ad-hoc densify verification output (generated)
verify_base/
verify_dnf/
verify_dnf2/

# Cached molecule library + pre-resize backup (generated by data.py / rebuild_library.py)
data/library/
data/library_backup_pre_resize/

# Zero-docking sub-library for the GP-MOBO head-to-head (build_cached_arena.py)
data/library_cached_arena/

# GP-MOBO reference implementation: a pinned clone of an upstream repo that
# publishes no LICENSE, so it is fetched rather than vendored. See gpmobo_ref.py.
external/

# GP-MOBO baseline + arena benchmark output (generated)
baseline_gpmobo_results/
benchmark_gpmobo_arena/
benchmark_gpmobo_arena_normalized/

# Run logs from long benchmarks (nohup ... > foo.log)
*.log

# Control-panel run logs (generated by app.py)
runs/

# Ablation / baseline output written to the repo root by run_ablation.py --save
# and the baselines' built-in comparison plots (generated).
results_coregionalized/
results_independent/
all_baselines_comparison.png

# Archived feature-matrix sweeps (generated by run_matrix.py; see matrix_results/)
matrix_results_run*/

# Pre-NADPH-fix receptor + docking cache backup (generated)
apo_backup_*/
